{
  "name": "bookshelf",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20 <23" },

  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",

    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p $PORT",

    "migrate:deploy": "prisma migrate deploy",
    "prestart": "prisma migrate deploy",

    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:reset": "prisma migrate reset",
    "db:seed": "ts-node -P tsconfig.seed.json prisma/seed.ts"
  },

  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.16.3",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.58.0",
    "@tailwindcss/postcss": "^4.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.14",
    "lucide-react": "^0.544.0",
    "next": "15.5.3",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.5.6",
    "prisma": "6.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "uuid": "^13.0.0",
    "zod": "^4.1.8",
    "zustand": "^5.0.8"
  },

  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "ts-node": "10.9.2",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5"
  },

  "prisma": {
    "seed": "ts-node -P tsconfig.seed.json prisma/seed.ts"
  }
}
